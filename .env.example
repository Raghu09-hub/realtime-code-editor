# ── Server ────────────────────────────────────────────────────────────────────
# Port for the Express + Socket.io server (default: 5000)
PORT=5000

# CORS origin for the Socket.io server (default: * for dev; set to your domain in prod)
CORS_ORIGIN=http://localhost:3000

# ── React Frontend ────────────────────────────────────────────────────────────
# URL of the backend server (used by the React app to reach Socket.io + /api/run)
REACT_APP_BACKEND_URL=http://localhost:5000

# ── Code Execution — Judge0 CE (via RapidAPI) ─────────────────────────────────
# Get a free key at: https://rapidapi.com/judge0-official/api/judge0-ce
# Leave blank to see the configuration instructions in the output panel.
JUDGE0_RAPIDAPI_KEY=

# Base URL for Judge0. Change this if you're self-hosting Judge0:
#   JUDGE0_URL=http://localhost:2358
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# ── Execution Limits ──────────────────────────────────────────────────────────
# Wall-clock timeout per submission (seconds)
EXEC_TIMEOUT_SEC=5

# Memory limit per submission (kilobytes; 131072 = 128 MB)
EXEC_MEMORY_KB=131072

# Maximum output size before truncation (bytes; 102400 = 100 KB)
EXEC_MAX_OUTPUT_BYTES=102400
